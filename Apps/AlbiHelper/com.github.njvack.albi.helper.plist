<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- albi-helper's launchd job. The app registers it with
     SMAppService.daemon(plistName:); BundleProgram is relative to the app.
     KeepAlive restarts it after a crash, and at startup it reconnects if
     helper-state.json says the user wants to be connected. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.github.njvack.albi.helper</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/albi-helper</string>
	<key>ProgramArguments</key>
	<array>
		<string>albi-helper</string>
		<string>run</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>com.github.njvack.albi.helper</key>
		<true/>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.github.njvack.albi.menu</string>
	</array>
</dict>
</plist>
