<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app as a LaunchAgent: Launch at Login registers it with
     SMAppService.agent(plistName:). It starts the app at login, and again if
     it crashes; a normal quit exits 0, which KeepAlive leaves alone. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.github.njvack.albi.menu</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/Albi Menu</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.github.njvack.albi.menu</string>
	</array>
</dict>
</plist>
